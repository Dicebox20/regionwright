import { createWaterworksPressureConfig, evaluateWaterworksPressure, adjustWaterworksValve, resetWaterworksPressure } from './waterworks-pressure-engine.js';
const escapeHTML = value => String(value ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const rootFor = app => app?.element?.[0] ?? app?.element;
function renderPanel(config,state,message='') {
  const result=evaluateWaterworksPressure(config,state);
  const gauges=result.valves.map(v=>`<div class="rw-waterworks-valve rw-waterworks-${v.id}"><strong>${v.id.toUpperCase()}</strong><div role="meter" aria-label="${v.id} pressure" aria-valuemin="0" aria-valuemax="5" aria-valuenow="${v.position}" class="rw-waterworks-gauge"><span style="height:${v.position*20}%"></span></div><div class="rw-waterworks-controls"><button type="button" data-valve="${v.id}" data-step="-1" aria-label="Decrease ${v.id}">−</button><output>${v.position}</output><button type="button" data-valve="${v.id}" data-step="1" aria-label="Increase ${v.id}">+</button></div></div>`).join('');
  const status=result.success?'The pipes sing in harmony.':result.balanced?'Pressure balanced; a blockage remains.':result.blockageCleared?'Flow path clear; adjust the valves.':'The line is obstructed.';
  const hotspots = result.valves.map((v,i)=>`<button type="button" class="rw-waterworks-hotspot rw-waterworks-hotspot--${v.id}" style="left:${[26.8,38.6,50.8,62.4,73.5][i]}%;top:38%" data-valve="${v.id}" data-step="1" aria-label="Turn ${v.id} valve clockwise. Current pressure ${v.position} of 5" title="${v.id.toUpperCase()} valve: ${v.position}/5"></button>`).join("");
  return `<section class="rw-waterworks" aria-label="Waterworks pressure puzzle"><h2>Waterworks Pressure</h2><p>${escapeHTML(message||status)}</p><div class="rw-waterworks-art-board" role="group" aria-label="Five pressure valves and two main flow controls"><div class="rw-waterworks-art-guide">Five upper valves • left intake • lower main control</div>${hotspots}<button type="button" class="rw-waterworks-hotspot rw-waterworks-intake" data-intake-toggle aria-label="Turn left supply valve" title="Intake supply"></button><button type="button" class="rw-waterworks-hotspot rw-waterworks-main" data-main-toggle aria-label="Turn lower main valve" title="Main flow"></button></div><div class="rw-waterworks-gauges">${gauges}</div><div class="rw-waterworks-actions"><button type="button" data-clear-blockage ${state.blockageCleared?'disabled':''}>${state.blockageCleared?'Obstruction cleared':'Clear pipe obstruction (test)'}</button><button type="button" data-waterworks-check>Test pressure</button><button type="button" data-waterworks-reset>Reset test</button></div><p role="status" class="rw-waterworks-status">${escapeHTML(status)}</p></section>`;
}
export async function openStandaloneWaterworksPressurePuzzle() {
  const DialogV2=globalThis.foundry?.applications?.api?.DialogV2;
  if (!DialogV2) throw new Error('Foundry dialog API unavailable');
  const config=createWaterworksPressureConfig();
  class WaterworksDialog extends DialogV2 {
    constructor(){super({classes:['regionwright','rw-waterworks-dialog'],window:{title:'Waterworks Pressure (standalone test)',resizable:true},position:{width:750,height:530},content:renderPanel(config,resetWaterworksPressure()),buttons:[{action:'close',label:'Close'}]});this.state=resetWaterworksPressure();this.intakeOpen=false;this.mainOpen=false;}
    _onRender(context,options){super._onRender(context,options);const root=rootFor(this);root?.addEventListener('click',event=>{const valve=event.target.closest?.('[data-valve]');if(valve){this.state=adjustWaterworksValve(config,this.state,valve.dataset.valve,Number(valve.dataset.step));this.refresh();return;}if(event.target.closest?.('[data-intake-toggle]')){this.intakeOpen=!this.intakeOpen;this.refresh(this.intakeOpen?'Intake opened.':'Intake closed.');return;}if(event.target.closest?.('[data-main-toggle]')){this.mainOpen=!this.mainOpen;this.refresh(this.mainOpen?'Main valve opened.':'Main valve closed.');return;}if(event.target.closest?.('[data-clear-blockage]')){this.state={...this.state,blockageCleared:true};this.refresh();return;}if(event.target.closest?.('[data-waterworks-reset]')){this.state=resetWaterworksPressure();this.intakeOpen=false;this.mainOpen=false;this.refresh('Test reset.');return;}if(event.target.closest?.('[data-waterworks-check]')){this.refresh((evaluateWaterworksPressure(config,this.state).success && this.intakeOpen && this.mainOpen)?'Pressure stabilized!':'The mechanism is not ready.');}});}
    refresh(message=''){const section=rootFor(this)?.querySelector('.rw-waterworks');if(section)section.outerHTML=renderPanel(config,this.state,message);}
  }
  const dialog=new WaterworksDialog();await dialog.render({force:true});return dialog;
}
