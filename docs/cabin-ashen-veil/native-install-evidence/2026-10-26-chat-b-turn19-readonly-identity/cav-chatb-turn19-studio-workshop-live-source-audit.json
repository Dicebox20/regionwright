  "prayers": [
    {
      "name": "Prayer of Devotion",
      "uuid": "Item.GXLYq6Tf4OgPNbkU",
      "description": "<p>A careful transcription of an old prayer discovered inscribed into masonry. The words honor devotion, constancy, and love, with the unmistakable warmth of a hymn to Sune.</p><p>Age has weathered the stone from which it was copied, but not the intention behind the invocation. It is meant to be spoken, not merely collected.</p>",
      "library": "GM_LIBRARY_ONLY"
    },
    {
      "name": "Prayer of Protection",
      "uuid": "Item.5jwy75XyFezukf3b",
      "description": "<p>A family prayer found inside the Ornate Music Box. Its complete owner-approved text and separate readable Journal must be verified before player handout. Reading it at Dahlia’s Art Studio Sune altar reveals the concealed Candle Workshop passage.</p>",
      "library": "GM_LIBRARY_ONLY"
