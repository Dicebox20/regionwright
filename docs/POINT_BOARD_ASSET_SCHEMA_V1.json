{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regionwright Point-Board Asset Metadata v1",
  "description": "Runtime metadata for a module-owned horizontal PNG spritesheet. Artwork source and authorship provenance are tracked separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "spriteSheet",
    "frameWidth",
    "frameHeight",
    "frameCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "spriteSheet": {
      "type": "string",
      "description": "A relative PNG path from the owning module root. Absolute, remote, parent-relative, and Windows-style paths are not allowed.",
      "pattern": "^(?!/)(?!\\s)(?!.*\\s$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*[%?#])[^\\\\\\r\\n]+\\.png$"
    },
    "frameWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "frameHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "frameCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleFrame": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based frame held when the asset is not moving. Defaults to frame 0."
        },
        "walk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startFrame",
            "frameCount",
            "fps"
          ],
          "properties": {
            "startFrame": {
              "type": "integer",
              "minimum": 0
            },
            "frameCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 30
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "spriteSheet": "assets/hunting/deer-point-board.png",
      "frameWidth": 115,
      "frameHeight": 96,
      "frameCount": 7,
      "animation": {
        "idleFrame": 0,
        "walk": {
          "startFrame": 1,
          "frameCount": 6,
          "fps": 8
        }
      }
    }
  ]
}
